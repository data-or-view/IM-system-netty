<configuration>
    <property name="LOG_HOME" value="logs"/>
    <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [trace=%X{trace_id:-no-trace}] [req=%X{request_id:-no-request}] [user=%X{app.user.id:-}] [op=%X{app.operation:-}] [conn=%X{connection_id:-}] [seq=%X{ws.seq:-}] %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/im-system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/im-system.%d{yyyyMMdd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 关闭 Netty 连接日志（太吵） -->
    <logger name="io.netty.handler.logging.LoggingHandler" level="WARN"/>
    <logger name="io.netty.handler.codec.http.websocketx.WebSocketServerProtocolHandler" level="WARN"/>
    <logger name="io.netty.handler.codec.http.HttpObjectAggregator" level="WARN"/>
</configuration>
