<configuration>
    <property name="LOG_HOME" value="logs"/>
    <!--
      MDC 字段是后续接入 Kafka/JSON appender 前的稳定日志契约：
      node/trace/request/user/op/proto/client 用于请求排障，
      msg/conv/topic 用于消息、MQ、跨节点异步链路排障。
    -->
    <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [node=%X{node_id:-}] [trace=%X{trace_id:-no-trace}] [req=%X{request_id:-no-request}] [user=%X{app.user.id:-}] [op=%X{app.operation:-}] [proto=%X{app.protocol:-}] [client=%X{client_ip:-}] [conn=%X{connection_id:-}] [seq=%X{ws.seq:-}] [msg=%X{message_id:-}] [clientMsg=%X{client_msg_id:-}] [conv=%X{conversation_id:-}] [topic=%X{mq.topic:-}] %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/im-system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/im-system.%d{yyyyMMdd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 关闭 Netty 连接日志（太吵） -->
    <logger name="io.netty.handler.logging.LoggingHandler" level="WARN"/>
    <logger name="io.netty.handler.codec.http.websocketx.WebSocketServerProtocolHandler" level="WARN"/>
    <logger name="io.netty.handler.codec.http.HttpObjectAggregator" level="WARN"/>
</configuration>
